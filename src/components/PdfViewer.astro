---
/**
 * 按 slug 渲染论文 PDF。地址在构建期从注册表算出，未知 slug 会让构建失败。
 */
import { paperAssetPath, requirePaper } from "../data/papers";

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const paper = requirePaper(slug);
const href = paperAssetPath(import.meta.env.BASE_URL, paper.file);
const arxiv = `https://arxiv.org/abs/${paper.arxivId}`;
---

<figure class="pdf-viewer">
  <figcaption class="pdf-bar">
    <a class="pdf-title" href={arxiv} target="_blank" rel="noopener">{paper.title}</a>
    <a class="pdf-open" href={href} target="_blank" rel="noopener">在新标签打开 ↗</a>
  </figcaption>
  <iframe class="pdf-frame" src={href} title={paper.title} loading="lazy"></iframe>
  <p class="pdf-fallback">无法内嵌 PDF？<a href={href} download>下载</a>。</p>
</figure>
